  "class_type": "Trellis2TextureStage",
  "inputs": {
   "positive": [
    "upst",
    0
   ],
   "negative": [
    "upst",
    1
   ],
   "shape_latent": [
    "k3",
    0
   ]
  }
 },
 "k4": {
  "class_type": "KSampler",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "positive": [
    "tex",
    0
   ],
   "negative": [
    "tex",
    1
   ],
   "latent_image": [
    "tex",
    2
   ],
   "seed": 43,
   "steps": 24,
   "cfg": 1.0,
   "sampler_name": "euler",
   "scheduler": "normal",
   "denoise": 1.0
  }
 },
