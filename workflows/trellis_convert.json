   "sign_mode.fill": 20,
   "sign_mode.qef": false,
   "band": 1.0,
   "project_back": 0.0,
   "fix_poles": false,
   "smooth_iters": 20,
   "drop_small_components": 0.01,
   "precluster_max_verts": 20000000
