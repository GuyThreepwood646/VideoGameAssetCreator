    "upst",
    0
   ],
   "negative": [
    "upst",
    1
   ],
   "latent_image": [
    "upst",
    2
   ],
   "seed": 42,
   "steps": 12,
   "cfg": 7.5,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1.0
