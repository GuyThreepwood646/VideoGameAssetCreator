{
  "_comment": "Defaults, true on any machine. Paths are absolute or relative to projectRoot; projectRoot is relative to this file (the launcher also looks upward for the project folder). This machine's values (for example comfyA.desktopExe, card names, comfyB.startScript) go in local/machine.json under \"desktop\", in the same shape as this file, and are laid over it. Edit, then restart the launcher.",
  "projectRoot": "..",
  "comfyA": {
    "name": "ComfyUI A",
    "url": "http://127.0.0.1:8188"
  },
  "comfyB": {
    "name": "ComfyUI B (images and rigging)",
    "url": "http://127.0.0.1:8189",
    "log": "runtime/logs/comfy-b.log",
    "processName": "python.exe",
    "processMatch": "ComfyUI\\main.py --port 8189",
    "startTimeoutSeconds": 300
  },
  "backend": {
    "name": "Backend (FastAPI)",
    "url": "http://127.0.0.1:8765",
    "healthPath": "/api/health",
    "python": "backend/.venv/Scripts/python.exe",
    "args": ["-m", "uvicorn", "vgac.main:app", "--host", "127.0.0.1", "--port", "8765"],
    "cwd": "backend",
    "log": "runtime/logs/backend.log",
    "processName": "python.exe",
    "processMatch": "uvicorn vgac.main:app --host 127.0.0.1 --port 8765",
    "startTimeoutSeconds": 120
  },
  "frontend": {
    "name": "UI (frontend build served by the backend)",
    "dir": "frontend",
    "dist": "frontend/dist",
    "buildCommand": "npm run build",
    "buildLog": "runtime/logs/frontend-build.log"
  },
  "logsFolder": "runtime/logs",
  "exportsFolder": "exports",
  "launcherLog": "runtime/logs/launcher.log",
  "window": { "width": 1440, "height": 900, "minWidth": 1200, "minHeight": 800 },
  "pollIntervalMs": 2000
}
