# Python
backend/.venv/
__pycache__/
*.pyc
.env

# Node
frontend/node_modules/
frontend/dist/

# Asset storage (generated content, large)
library/
runtime/*
!runtime/start-comfy-b.ps1
!runtime/start-comfy-a.ps1

# Unity sandbox generated folders
unity-sandbox/Library/
unity-sandbox/Logs/
unity-sandbox/Temp/
unity-sandbox/obj/
unity-sandbox/UserSettings/
unity-sandbox/Assets/VGAC/
unity-sandbox/Assets/VGAC.meta

# Experiment outputs and scratch
bakeoff/out/
bakeoff/realistic_test/
bakeoff/__pycache__/
tools/e2e_report.json
exports/

# Desktop launcher build output
desktop/dist/
desktop/node_modules/

# Animation packs: each user downloads these at setup (setup/downloads.json, setup/Setup-Extras.ps1 -Packs)
data/animations/

# Research, plans, audits, reviews and test write-ups stay on the owner's computer. Only the guides the readme links
# to are checked in. A new document under docs/ is ignored unless it is added to this list.
docs/*
!docs/FIRST-TIME-SETUP.md
!docs/ADVANCED.md
!docs/API.md
!docs/BACKEND.md
!docs/BUILD-THE-EXE.md
!docs/images/
bakeoff/BAKEOFF.md
